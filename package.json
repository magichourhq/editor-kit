{
  "name": "@magichourhq/editor-kit",
  "version": "0.1.2",
  "description": "Shared video generation flow for Magic Hour's design editor apps",
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magichourhq/editor-kit.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.test.json",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@magichourhq/browser-client": "^0.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
